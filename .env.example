PORT=8787
LEXSOURCE_DB=var/lexsource.db

# 采集评审用 Azure OpenAI。本地可不填：macOS 会读钥匙链
# AZURE_OPENAI_API_URL / AZURE_OPENAI_API_KEY
# 不要把真实 Key 提交进仓库。
AZURE_OPENAI_API_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=DeepSeek-V4-Flash

# 可选：让采集 Agent 通过 MCP 使用 Playwright
# LEXSOURCE_MCP_PLAYWRIGHT=1
# 或自定义：LEXSOURCE_MCP_SERVERS=[{"id":"playwright","command":"npx","args":["-y","@playwright/mcp@latest"]}]
